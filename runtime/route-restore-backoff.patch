+
+
+def test_route_restore_never_turns_a_missing_field_into_none(tmp_path, monkeypatch):
+    """A field the agent did not have before the routed turn is absent after it, not None:
+    ``_rate_limit_backoff_count = None`` failed the next rate-limited turn on ``None + 1``."""
+    with FakeLLMServer([Text("main one")]) as main, FakeLLMServer([Text("voice reply")]) as voice:
+        home = write_hermes_home(tmp_path / ".hermes", main.base_url, extra_config=(
+            "auxiliary:\n  voice_chat:\n    provider: custom\n"
+            f"    base_url: {voice.base_url}\n    model: voice-model\n    api_key: sk-fake-voice\n"
+        ))
+        monkeypatch.setenv("HERMES_HOME", str(home))
+        agent = _agent(home, main.base_url)
+        agent.__dict__.pop("_rate_limit_backoff_count", None)
+        agent._voice_turn_pending = True
+        agent.run_conversation("spoken question")
+        assert getattr(agent, "_rate_limit_backoff_count", 0) is not None
+
+        from agent.fallback_cooldown import _arm_rate_limit_cooldown
+        from agent.error_classifier import FailoverReason
+        agent._rate_limit_backoff_count = None  # tolerated as well
+        agent._fallback_activated = False
+        assert _arm_rate_limit_cooldown(agent, FailoverReason.rate_limit) == 60
+        assert agent._rate_limit_backoff_count == 1
