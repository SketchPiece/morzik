# Без Cache-Control WebView в Telegram на iPhone держит страницу у себя и не спрашивает сервер,
# так что новая версия не доходит. no-cache: каждый раз проверять по ETag (неизменённое — 304, без перекачки).
server {
    listen 80;
    root /usr/share/nginx/html;
    add_header Cache-Control "no-cache" always;
    # Модель головы (morzik.js) — полмегабайта, сжатая — около 140 КБ.
    gzip on;
    gzip_types application/javascript text/css;
    # Адрес сервера Морзика в tailnet в репозиторий не кладём: он приходит из переменной MORZIK_SERVER
    # сервиса на pieces (только имя хоста, например sketch-server.<tailnet>.ts.net). Образ nginx при старте
    # подставляет её в этот шаблон, страницы берут адрес из /config.js.
    location = /config.js {
        default_type application/javascript;
        return 200 "window.MORZIK_SERVER = '${MORZIK_SERVER}';\n";
    }
    # Любой другой путь (например, старый адрес в кнопке меню) — та же страница, а не 404.
    location / { try_files $uri /index.html; }
}
