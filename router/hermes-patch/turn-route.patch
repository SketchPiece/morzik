+
+
+def test_plugin_turn_route_runs_one_turn_on_its_task(tmp_path, monkeypatch):
+    """``pre_llm_call`` returning ``{"turn_route": task}`` runs that turn on ``auxiliary.<task>``."""
+    import hermes_cli.lifecycle as lifecycle
+
+    with FakeLLMServer([Text("main one"), Text("main two")]) as main, \
+            FakeLLMServer([Text("light reply")]) as light:
+        home = write_hermes_home(tmp_path / ".hermes", main.base_url, extra_config=(
+            "auxiliary:\n  light_test:\n    provider: custom\n"
+            f"    base_url: {light.base_url}\n    model: light-model\n    api_key: sk-fake-light\n"
+            "custom_providers:\n  - name: light\n"
+            f"    base_url: {light.base_url}\n    models:\n      light-model:\n        context_length: 128000\n"
+        ))
+        monkeypatch.setenv("HERMES_HOME", str(home))
+        original = lifecycle.invoke_hook
+
+        def invoke_hook(name, **kwargs):
+            if name == "pre_llm_call" and kwargs.get("user_message") == "light question":
+                return [{"turn_route": "light_test"}]
+            return original(name, **kwargs)
+
+        monkeypatch.setattr(lifecycle, "invoke_hook", invoke_hook)
+        agent = _agent(home, main.base_url)
+
+        first = agent.run_conversation("heavy question")
+        routed = agent.run_conversation("light question", conversation_history=first["messages"])
+        agent.run_conversation("heavy again", conversation_history=routed["messages"])
+
+        assert [r["model"] for r in light.main_requests()] == ["light-model"]
+        assert [r["model"] for r in main.main_requests()] == ["fake-model", "fake-model"]
+        assert routed["model"] == "light-model"
+        assert agent.model == "fake-model"
+        assert agent._turn_route_task_pending == ""
